# Puerto del servidor. Render lo inyecta solo.
PORT=10000

# Secreto para firmar las sesiones. Minimo 16 caracteres.
# En produccion: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-32-caracteres-hex

# Hash de la contrasena del DUENO. Se genera con:
#   npm run hash-clave -- "la contrasena"
DUENO_PIN_HASH=scrypt$pega-aqui$el-hash

# URL del despliegue de Google Apps Script (/exec) y su clave compartida.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_API_KEY=

# Opcional: llave extra que el dueño puede poner en las 4 tiendas.
# Si se deja vacia, el sistema funciona sin ella (fail-open deliberado).
STORE_KEY=
